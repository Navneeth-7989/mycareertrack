# CareerTrack — required environment variables
# Copy to `.env` and fill in. `.env` is gitignored; this file is committed.

# ─────────────────────────────────────────────────────────────
# Database — Neon Postgres (Prisma)
# ─────────────────────────────────────────────────────────────
# DATABASE_URL : pooled connection, used by the app at runtime
# DIRECT_URL   : direct connection, used by `prisma migrate`
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/careertrack?sslmode=require"
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/careertrack?sslmode=require"

# ─────────────────────────────────────────────────────────────
# Auth.js v5 (NextAuth)
# ─────────────────────────────────────────────────────────────
# Generate with: npx auth secret
AUTH_SECRET=""

AUTH_URL="http://localhost:3000"

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# Redirect URI (dev):  http://localhost:3000/api/auth/callback/google
# Redirect URI (prod): https://your-domain/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub → Settings → Developer settings → OAuth Apps
# Callback URL (dev):  http://localhost:3000/api/auth/callback/github
# Callback URL (prod): https://your-domain/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ─────────────────────────────────────────────────────────────
# Supabase — Storage only (private resume bucket)
# ─────────────────────────────────────────────────────────────
# Supabase is not used for authentication or for application data.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Publishable key — safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Secret key — SERVER ONLY. Bypasses all storage policies.
# Must never carry the NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY="sb_secret_..."

SUPABASE_RESUME_BUCKET="resumes"
